<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="camera">
    <!-- Dummy root link with no inertia -->
    <link name="dummy_root_link"/>

    <!-- Camera link with inertia -->
    <link name="camera_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <geometry>
                <box size="0.1 0.2 0.2"/>  
            </geometry>
            <material name="Green">
                <color rgba="0.0 1.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <geometry>
                <box size="0.1 0.2 0.2"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.1"/> 
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
        </inertial>
    </link>

    <!-- Fixed joint connecting dummy root link to camera link -->
    <joint name="dummy_joint" type="fixed">
        <parent link="dummy_root_link"/>
        <child link="camera_link"/>
        <origin xyz="0.0 1.0 0.5" rpy="0 0 -1.57"/>  <!-- Adjust this to position the camera -->
    </joint>

    <!-- Gazebo sensor configuration -->
    <gazebo reference="camera_link">
        <sensor type="camera" name="camera">
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>300</far>
                </clip>
            </camera>
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <topic>camera/image_raw</topic>
            <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
                <render_engine>ogre2</render_engine>
            </plugin>
        </sensor>
    </gazebo> 
</robot>